{
  "manifest_version": 3,
  "name": "리뷰 요약 서비스",
  "version": "1.2.1",
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://smartstore.naver.com/*",
    "https://www.coupang.com/*",
    "https://brand.naver.com/*"
  ],
  "side_panel": {
    "default_path": "sidePanel/index.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}